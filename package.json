{
  "name": "kedge-plugin",
  "version": "0.1.0",
  "description": "Kedge Obsidian plugin",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "esbuild main.ts --bundle --outfile=main.js --external:obsidian --format=cjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm typecheck && jest",
    "smoke": "pnpm build && node scripts/smoke.mjs",
    "dev": "esbuild main.ts --bundle --outfile=main.js --external:obsidian --format=cjs --watch",
    "screenshot": "pnpm build && node scripts/screenshot.mjs"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2"
  }
}
