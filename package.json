{
  "name": "kedge-plugin",
  "version": "0.1.0",
  "description": "Kedge Obsidian plugin",
  "main": "main.js",
  "scripts": {
    "build": "esbuild main.ts --bundle --outfile=main.js --external:obsidian --format=cjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && jest",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "dev": "esbuild main.ts --bundle --outfile=main.js --external:obsidian --format=cjs --watch"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "obsidian": "^1.14.4",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true
  }
}
