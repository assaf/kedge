{
  "name": "kedge-plugin",
  "version": "0.1.0",
  "description": "Kedge Obsidian plugin",
  "main": "main.js",
  "scripts": {
    "build": "esbuild main.ts --bundle --outfile=main.js --external:obsidian --format=cjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && jest",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "dev": "esbuild main.ts --bundle --outfile=main.js --external:obsidian --format=cjs --watch"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^18.0.0",
    "esbuild": "^0.19.0",
    "jest": "^30.5.2",
    "obsidian": "latest",
    "ts-jest": "^29.4.15",
    "typescript": "^5.0.0"
  }
}
